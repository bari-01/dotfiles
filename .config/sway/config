#bindsym --whole-window $mod+Mod1+button4  exec $scripts/ws-rel.sh move -1
#bindsym --whole-window $mod+Mod1+button5  exec $scripts/ws-rel.sh move +1

# Multi-monitor
bindsym Ctrl+$mod+Mod1+Left  focus output left
bindsym Ctrl+$mod+Mod1+Right focus output right

# ---- Utilities --------------------------------------------------
bindsym $mod+c exec pkill fuzzel || cliphist list | fuzzel --match-mode fzf --dmenu | cliphist decode | wl-copy
# bindsym $mod+Shift+c exec hyprpicker -a
# forgot whats that

# Screenshots / recording
bindsym $mod+Shift+s                      exec $scripts/screenshot.sh region
bindsym --locked Print                    exec $scripts/screenshot.sh screen
bindsym --locked --no-repeat Ctrl+Print   exec $scripts/screenshot.sh screen-file
bindsym --locked $mod+Shift+r             exec $scripts/record.sh region
bindsym --locked Ctrl+Mod1+r              exec $scripts/record.sh screen
bindsym --locked $mod+Shift+Mod1+r        exec $scripts/record.sh screen sound

